# ============================================================
# TachoCompliance — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# ── Railway PostgreSQL ──────────────────────────────────────
# Disponible dans le dashboard Railway → Service → Variables
DATABASE_URL=postgresql://postgres:password@containers-us-west-xxx.railway.app:6543/railway

# ── Better Auth ─────────────────────────────────────────────
# Secret aléatoire (min 32 chars) : openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here

# URL publique de l'app (sans slash final)
# En dev : http://localhost:3000
# En prod : https://votre-domaine.com
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (Nodemailer + Neo Mail / Titan SMTP) ────────────
SMTP_HOST=smtp0001.neo.space
SMTP_PORT=465
SMTP_USER=votre-email@votredomaine.com
SMTP_PASS=votre-mot-de-passe
EMAIL_FROM=TachoCompliance <votre-email@votredomaine.com>
